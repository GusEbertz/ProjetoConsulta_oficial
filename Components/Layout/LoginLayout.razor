@using Microsoft.AspNetCore.Identity
@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="true"/>
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudText Typo="Typo.h6" Class="ml-3">Projeto Consulta</MudText>
        <MudSpacer/>
        <MudStack>
            <MudIconButton Href="/" Icon="@Icons.Material.Filled.Home" Color="Color.Inherit"></MudIconButton>
        </MudStack>
    </MudAppBar>

    <MudMainContent Class="mt-16 pa-4">
        @Body
    </MudMainContent>
</MudLayout>



